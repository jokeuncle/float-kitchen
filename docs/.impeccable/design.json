  "narrative": {
    "northStar": "深夜小馆 / The Warm Miniature Bistro",
    "overview": "Float Kitchen makes waiting feel like watching a small late-night restaurant at work. Ceramic robot chefs, ivory tile, copper cookware, cherrywood and forest green carry the warmth; an espresso shell gives the authored scene a quiet desktop setting. This language comes from the approved kitchen brief and existing implementation.\n\nThe artwork is expressive while information stays still. Native controls, source labels and paper receipts make the performance understandable without turning an event into a claim about the model's thoughts. This document belongs to the independent Float Kitchen app; Orbit's visual system remains separate.",
    "keyCharacteristics": [
      "Authored miniature kitchen art with eight distinct chef poses.",
      "Espresso surroundings, cream reading text and copper selection.",
      "Steady paper signs and selectable native receipts.",
      "State-specific compositor motion with accessibility and visibility gates."
    ],
    "rules": [
      {
        "name": "The Named State Rule",
        "body": "Color supports the activity name and pose; color alone must not identify a state.",
        "section": "colors"
      },
      {
        "name": "The Shared Baseline Rule",
        "body": "Symbols beside text use one `NSTextAttachment` run, with vertical offset `(font.capHeight - iconHeight) / 2`; do not position an unrelated icon by eye. Button symbols are 14pt, standalone controls 15pt, and the brand symbol 24pt.",
        "section": "typography"
      },
      {
        "name": "The Measured Sign Rule",
        "body": "Fit each sign line using the actual native font width and a measured trailing ellipsis before drawing. Keep the source/activity line and detail line independent and single-line.",
        "section": "typography"
      },
      {
        "name": "The Stable Reading Plane Rule",
        "body": "Keep signs and surrounding information outside the animated layer-hosting subtree. Only the state artwork and local effects move.",
        "section": "elevation & depth"
      },
      {
        "name": "The Independent Motion Rule",
        "body": "A client event changes that client's pose and motion without restarting the others. Pause, Reduce Motion, hiding/occlusion and sleep remove continuous effects; static poses and signs retain meaning. A one-second model timer and background polling remain separate from compositor animation; there is no Swift frame redraw timer.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve the authored warm bistro world and native system typography.",
      "Do keep client, activity and safe detail readable on a steady paper sign.",
      "Do use shared cap-height symbol alignment and measured single-line ellipsis.",
      "Do preserve independent client motion, Reduce Motion and menu-bar recovery.",
      "Do distinguish fictional demo, observed live activity and unknown or stale state."
    ],
    "donts": [
      "Don't reintroduce separate foreground props or shared-atlas sampling that bleeds neighboring poses.",
      "Don't move signs into the animated scene or let motion cover information.",
      "Don't infer private reasoning, approval, failure or task quality from decorative motion.",
      "Don't equate display callback cadence with guaranteed GPU frame presentation."
    ]
  }
